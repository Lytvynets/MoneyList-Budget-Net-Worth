    },
    "A one-time in-app purchase tied to your Apple Account. Restore it on any of your devices." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разова покупка в застосунку, прив’язана до вашого облікового запису Apple. Її можна відновити на будь-якому вашому пристрої."
          }
        }
      }
    },
    "A quiet nudge at 9 pm to note the day." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихе нагадування о 21:00 записати витрати дня."
