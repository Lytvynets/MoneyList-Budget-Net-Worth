    "%@ a month to finish by %@" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ на місяць, щоб устигнути до %@"
          }
        }
      }
    },
    "%@ is at %lld%%" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»: використано %lld%%"
          }
        }
      }
    },
    "%@ is down %lld%% on last month — %@ so far." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»: на %lld%% менше, ніж минулого місяця, — поки що %@."
